{
  "name": "kotoba-deck",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Japanese vocabulary deck with a compositional conjugation engine",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite build && vite preview --host",
    "android": "vite build && cap sync android",
    "icons": "node scripts/make-icons.mjs",
    "dict": "node --max-old-space-size=4096 scripts/build-dict.mjs",
    "test": "node test/engine.test.mjs && node test/sw.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1"
  }
}
